# Copy to .env and edit before running `make up`.
#   cp deploy/compose/.env.example deploy/compose/.env

# ---- Public addresses ----
# Address Caddy serves. Use http://localhost for a quick local run, or a real
# domain (e.g. inbox.example.com) to get automatic HTTPS.
SITE_ADDRESS=http://localhost
PUBLIC_BASE_URL=http://localhost
ALLOWED_ORIGINS=http://localhost
# Leave empty for same-origin API calls through Caddy. Set to the API origin
# (e.g. http://localhost:8080) only if you bypass Caddy during development.
NEXT_PUBLIC_API_BASE_URL=

# Browser-reachable storage host used to sign upload/download URLs.
STORAGE_PUBLIC_ENDPOINT=localhost:9000
STORAGE_USE_SSL=false

# ---- Database ----
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inbox

# ---- Object storage (MinIO) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
STORAGE_BUCKET=attachments

# ---- Host account (seeded on first run) ----
HOST_EMAIL=host@example.com
HOST_NAME=Host
HOST_PASSWORD=change-me-too

# ---- Email ----
# console | smtp | postmark
MAILER_DRIVER=console
MAIL_FROM_ADDRESS=inbox@example.com
MAIL_FROM_NAME=Inbox
POSTMARK_SERVER_TOKEN=

# ---- Runtime ----
APP_ENV=production
SESSION_COOKIE_SECURE=false
WORKER_POLL_INTERVAL=2s
