# Copy to .env and edit before running `make up`.
#   cp deploy/compose/.env.example deploy/compose/.env

# ---- Public addresses ----
# Address Caddy serves for the API. Use http://localhost for a quick local run,
# or a real domain (e.g. api.example.com) to get automatic HTTPS.
SITE_ADDRESS=http://localhost
# Origin where the static frontend is served (local :3000, or your static host).
# Used to build visitor links (PUBLIC_BASE_URL) and for CORS (ALLOWED_ORIGINS).
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Browser-reachable storage host used to sign upload/download URLs.
STORAGE_PUBLIC_ENDPOINT=localhost:9000
STORAGE_USE_SSL=false

# ---- Database ----
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inbox

# ---- Object storage (SeaweedFS, S3-compatible) ----
# These credentials are used by both the storage service and the app.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=change-me
STORAGE_BUCKET=attachments

# ---- Host account (seeded on first run) ----
HOST_EMAIL=host@example.com
HOST_NAME=Host
HOST_PASSWORD=change-me-too

# ---- Email ----
# console | smtp | postmark
MAILER_DRIVER=console
MAIL_FROM_ADDRESS=inbox@example.com
MAIL_FROM_NAME=Inbox
POSTMARK_SERVER_TOKEN=

# ---- Runtime ----
APP_ENV=production
SESSION_COOKIE_SECURE=false
WORKER_POLL_INTERVAL=2s
