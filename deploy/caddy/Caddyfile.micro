# Caddyfile for the microservice layout — TLS termination and a single entry
# point to the API gateway. The frontend is a static site served separately.

{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy gateway:8080
	}
	handle /healthz {
		reverse_proxy gateway:8080
	}
	handle /readyz {
		reverse_proxy gateway:8080
	}

	log {
		output stdout
		format console
	}
}
