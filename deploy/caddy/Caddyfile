# Caddyfile — TLS termination and reverse proxy for the API.
#
# The frontend is a static site served separately (locally on :3000, or on
# GitHub Pages). Caddy only fronts the backend API here.
#
# SITE_ADDRESS is provided by the compose environment. Set it to a bare domain
# (e.g. api.example.com) for automatic HTTPS, or http://localhost locally.

{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}

	log {
		output stdout
		format console
	}
}
